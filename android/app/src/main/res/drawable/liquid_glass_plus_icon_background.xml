<?xml version="1.0" encoding="utf-8"?>
<!-- iOS 26 Liquid Glass Plus Icon Background -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base glass circle -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#2A1A3E"/>
        </shape>
    </item>
    
    <!-- Glass highlight -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:startColor="#FFFFFF25"
                android:endColor="#00000000"
                android:angle="270"/>
        </shape>
    </item>
    
    <!-- Border glow -->
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="1.5dp"
                android:color="#FF9500"/>
        </shape>
    </item>
    
    <!-- Gradient accent -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:startColor="#FF950040"
                android:endColor="#E5091440"
                android:angle="45"/>
        </shape>
    </item>
</layer-list>
