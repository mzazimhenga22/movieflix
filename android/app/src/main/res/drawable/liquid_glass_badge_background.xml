<?xml version="1.0" encoding="utf-8"?>
<!-- iOS 26 Liquid Glass Badge Background -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base glass -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#121215"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
    
    <!-- Subtle highlight -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FFFFFF15"
                android:endColor="#00000000"
                android:angle="270"/>
            <corners android:radius="7dp"/>
        </shape>
    </item>
    
    <!-- Thin border -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#FFFFFF30"/>
            <corners android:radius="7dp"/>
        </shape>
    </item>
</layer-list>
