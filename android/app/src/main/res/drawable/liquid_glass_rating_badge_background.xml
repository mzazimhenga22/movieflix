<?xml version="1.0" encoding="utf-8"?>
<!-- iOS 26 Liquid Glass Rating Badge -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base glass fill -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2A1A3E"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
    
    <!-- Inner highlight -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FFFFFF20"
                android:endColor="#00000000"
                android:angle="270"/>
            <corners android:radius="11dp"/>
        </shape>
    </item>
    
    <!-- Border glow -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#E50914"/>
            <corners android:radius="11dp"/>
        </shape>
    </item>
    
    <!-- Gradient accent -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#E5091440"
                android:endColor="#B2071040"
                android:angle="45"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
</layer-list>
